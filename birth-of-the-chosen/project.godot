; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Birth of The Chosen"
config/description="When the \"God\" of the world took 5 children 25 years ago, we thought nothing of it, now he comes back announcing the \"Chosen Festival\" where 5 demi-gods will be revealed to the world, I'm sure these are connected."
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=240
config/icon="res://icon.svg"

[autoload]

VoidSwitch="*uid://bg7yld50mwfn1"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://Level Items/": "orange",
"res://Mechanics/": "yellow",
"res://Player/": "red"
}

[gui]

theme/default_font_multichannel_signed_distance_field=true

